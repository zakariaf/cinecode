            { "do": "walk", "who": "pebble", "to": "x:480,y:1050", "at": 0 },
            { "say": "fidget", "text": "Morning, boulder! Where you headed?", "tone": "bright", "at": 0.2, "expr": "happy" },
            { "say": "pebble", "text": "The standing stone. Tonight.", "tone": "slow, gravel", "after": 0.6 }
          ], "hold": 0.5 },
        { "id": "2.3", "camera": { "size": "full", "on": ["fidget"] },
          "beats": [
            { "say": "fidget", "text": "At this speed? You'll get there next spring!", "tone": "delighted", "at": 0.2, "expr": "laugh" },
            { "do": "gesture", "who": "fidget", "name": "laugh" },
            { "sfx": "laugh-squirrel", "with": "prev", "caption": "[laughs]" }
          ], "hold": 0.3 },
        { "id": "2.4", "camera": { "size": "full", "on": ["hollis", "fidget"] },
          "beats": [
            { "say": "hollis", "text": "Then he'll be seventy-five years early for the next comet.", "tone": "dry, half asleep", "at": 0.3 },
            { "do": "pose", "who": "fidget", "pose": "alert", "dur": 0.3 },
            { "do": "look", "who": "fidget", "at": "hollis" }
          ], "hold": 0.5 },
        { "id": "2.5", "camera": { "size": "close", "on": ["hollis"] },
          "beats": [
            { "do": "emote", "who": "hollis", "expr": "one-eye", "at": 0.3 },
            { "say": "hollis", "text": "When the standing stone goes dark, the comet blooms.", "tone": "pedantic", "after": 0.3 }
          ], "hold": 0.5 },
        { "id": "2.6", "camera": { "size": "medium", "on": ["hollis"] },
          "beats": [
            { "say": "hollis", "text": "Take the stream. Now kindly go aw—", "tts": "Take the stream. Now kindly go away.", "trimEnd": 0.22, "tone": "drifting off", "at": 0.2 },
            { "do": "emote", "who": "hollis", "expr": "sleepy" },
            { "do": "pose", "who": "hollis", "pose": "sleep", "dur": 0.6 },
            { "sfx": "snore", "with": "prev", "caption": "[snores]" }
          ], "hold": 1.2 },
        { "id": "2.7", "camera": { "size": "wide", "on": ["pebble", "fidget"], "move": "track" },
          "beats": [
            { "do": "walk", "who": "pebble", "to": "x:760,y:1050", "at": 0 },
            { "do": "look", "who": "fidget", "at": "far-hill", "at": 0.1 },
            { "do": "hop", "who": "fidget", "to": "on:pebble", "at": 0.9 },
            { "say": "fidget", "text": "Got a name, Old Shell?", "tone": "friendly", "after": 0.2 },
