  "scenes": [
    {
      "id": "s01", "set": "hill", "time": "night", "grade": "memory", "overlays": ["stars", "comet"],
      "music": { "mood": "wonder", "intensity": 0.35 }, "ambience": "meadow-night",
      "actors": {
        "young_nell":   { "at": "stone_left", "face": "left", "pose": "sit-ground" },
        "young_pebble": { "at": "x:2190", "face": "right", "pose": "rest" }
      },
      "shots": [
        { "id": "1.1", "camera": { "size": "establishing", "on": ["stone_front"], "move": "push-in" }, "fadeIn": 0.5,
          "beats": [
            { "say": "narrator", "text": "Once in a long life, a star with a tail comes back.", "tone": "softly", "at": 0.2 }
          ], "hold": 0.6 },
        { "id": "1.2", "camera": { "size": "medium", "on": ["young_nell", "young_pebble"] },
          "beats": [
            { "do": "gesture", "who": "young_nell", "name": "point", "at": 0.2 },
            { "say": "young_nell", "text": "When it comes back, will you be here?", "tone": "earnest", "with": "prev" },
            { "do": "look", "who": "young_pebble", "at": "sky" },
            { "do": "look", "who": "young_pebble", "at": "young_nell", "after": 0.5 },
            { "say": "young_pebble", "text": "I'll be here.", "tone": "steady", "after": 0.3 }
          ], "hold": 0.5 },
        { "id": "1.3", "camera": { "size": "close", "on": ["young_nell"] },
          "beats": [ { "say": "young_nell", "text": "Promise?", "tone": "solemn", "at": 0.2 } ], "hold": 0.5 },
        { "id": "1.4", "camera": { "size": "close", "on": ["young_pebble"] },
          "beats": [ { "say": "young_pebble", "text": "Promise.", "tone": "simple", "at": 0.3 } ], "hold": 0.6 },
        { "id": "1.5", "camera": { "size": "medium", "on": ["young_nell", "young_pebble"] },
          "beats": [
            { "do": "emote", "who": "young_nell", "expr": "angry", "at": 0.2 },
            { "say": "young_nell", "text": "Don't be late.", "tone": "stern, bossy" },
            { "say": "young_pebble", "text": "I'm a tortoise.", "tone": "deadpan", "after": 0.4 },
            { "do": "gesture", "who": "young_nell", "name": "laugh", "after": 0.2 },
            { "sfx": "laugh-child", "with": "prev", "caption": "[laughs]" },
            { "do": "gesture", "who": "young_nell", "name": "point" },
            { "do": "emote", "who": "young_nell", "expr": "happy" },
            { "do": "pose", "who": "young_nell", "pose": "sit-ground", "dur": 0.4 },
            { "sfx": "hum-child", "caption": "[hums]", "dur": 4.6 }
          ], "hold": 0.2 },
        { "id": "1.6", "camera": { "size": "establishing", "on": ["stone_front"] },
          "beats": [
            { "do": "custom", "name": "timelapse", "dur": 4.0, "at": 0 },
            { "do": "fade", "who": "young_nell", "to": 0, "dur": 1.2, "at": 0.2 },
            { "do": "fade", "who": "young_pebble", "to": 0, "dur": 1.2, "at": 0.2 },
            { "sfx": "music-box", "at": 0.1 },
            { "sfx": "wind-swell", "at": 2.2 }
          ], "dur": 4.0 }
      ]
    },
