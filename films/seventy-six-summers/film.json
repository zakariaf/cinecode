      "music": { "mood": "pastoral", "intensity": 0.35 },
      "actors": {
        "hollis": { "at": "low_branch", "face": "right", "pose": "sleep" },
        "fidget": { "at": "branch_tip", "face": "left", "pose": "perch" },
