#!/bin/sh
# `cinecode` as a bare command (Claude Code puts an enabled plugin's bin/ on the Bash tool's PATH): runs
# bin/cinecode.mjs with Node.
command -v node >/dev/null 2>&1 || { echo "cinecode needs Node.js 20 or newer on the PATH: https://nodejs.org" >&2; exit 1; }
exec node "$(dirname "$0")/cinecode.mjs" "$@"
